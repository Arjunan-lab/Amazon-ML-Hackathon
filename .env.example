# ==============================================================================
# Amazon ML Challenge - Environment Variables Template
# Copy this file to .env and adjust the values for your local environment
# ==============================================================================

# Project & Runtime Environment
ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# Paths
DATA_DIR=data
OUTPUT_DIR=output
MODELS_DIR=models

# Hardware & Training Settings
DEVICE=cuda            # "cuda" or "cpu"
BATCH_SIZE=32
NUM_WORKERS=4

# Optional Model & Experiment Tracking (e.g. WandB / MLflow)
# WANDB_API_KEY=your_wandb_api_key_here
# WANDB_PROJECT=amazon-ml-challenge-entity-matching
